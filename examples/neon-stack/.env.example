# Supply a write token for your target project. Management API keys are not write tokens.
LOGFIRE_TOKEN=
# Use the US ingest region. Change this for another region or a local stack.
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
# Supply the organization that owns your token's project.
LOGFIRE_ORGANIZATION=
# Supply the project that receives your telemetry.
LOGFIRE_PROJECT=
